# ---------------------------------------------------------------------------
# Ambiente de DESENVOLVIMENTO (docker compose). Sem segredos reais.
# 'make setup' copia este arquivo para api/.env; o compose lê api/.env.
# ---------------------------------------------------------------------------
APP_NAME="Codificar Ticketing"
APP_ENV=local
# Chave SOMENTE DE DEV, compartilhada por api, workers e scheduler (todos leem o mesmo .env).
# Em produção gere outra: php artisan key:generate --show
APP_KEY=base64:7N4MW4b1O6eLiUmkrQ7pIKK8UEiw4qkRDMkn3QF4spI=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=ticketing

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=vendas@codificar-ticketing.local
MAIL_FROM_NAME="Codificar Ingressos"

WEB_ORIGIN=http://localhost:5173

# Segredo compartilhado com os comandos gateway:* que simulam o provedor externo
GATEWAY_WEBHOOK_SECRET=dev-gateway-secret

# URL do microserviço finance-sim (projeto separado)
FINANCE_SIM_URL=http://finance-sim:8080

RESERVATION_TTL_MINUTES=15
MAX_QUANTITY_PER_ORDER=6
OUTBOX_MAX_ATTEMPTS=8
# Limite de POST /orders por IP/minuto. 0 = sem limite (use 0 em teste de carga)
ORDERS_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Habilita /api/v1/admin/dev/gateway/* e a tela /admin/gateway do front
ENABLE_DEV_TOOLS=true

# Usuário admin criado pelo seeder (DEV)
ADMIN_EMAIL=admin@codificar.dev
ADMIN_PASSWORD=password
