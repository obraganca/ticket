{
    "name": "codificar/ticketing-api",
    "type": "project",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.0",
        "endroid/qr-code": "^5.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "*",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/Support/Fakes.php",
            "tests/Support/helpers.php",
            "tests/Support/Concurrency.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
